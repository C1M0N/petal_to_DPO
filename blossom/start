#!/usr/bin/env bash
# blossom 一键开始/继续学习副本，并自动在 VS Code 里打开。
#
# 最常用：
#     ./start ch02           # 首次：复制可写副本 + 打开 VS Code
#                            # 之后：直接打开已有副本
#     ./start ch02 -f        # 重做：覆盖现有副本
#     ./start ch02 -d -n review   # 基于 demo（含答案）的复习副本
#
# 所有参数会原样传给 scripts/new_attempt.py，详见 `--help`。

set -e
cd "$(dirname "$0")"
exec python3 scripts/new_attempt.py "$@"
